{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HorizonJam Real Performance Pack v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "minimum_cases",
    "split_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "real-performance-pack-v1"
    },
    "status": {
      "enum": [
        "collecting",
        "frozen"
      ]
    },
    "minimum_cases": {
      "type": "integer",
      "minimum": 20
    },
    "held_out_frozen_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "held_out_labels_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_fraction",
        "held_out_fraction",
        "assignment_policy"
      ],
      "properties": {
        "development_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "held_out_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "assignment_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "split",
          "category",
          "audio",
          "provenance",
          "instrument",
          "qualities",
          "playing_styles",
          "conditions",
          "harmonic_examples",
          "annotations",
          "performer_id",
          "recording_session_id",
          "device_id"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "development",
              "held_out"
            ]
          },
          "category": {
            "enum": [
              "chord_isolation",
              "progression"
            ]
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "duration_sec"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "duration_sec": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rights_basis",
              "rights_reference",
              "source",
              "redistribution_allowed"
            ],
            "properties": {
              "rights_basis": {
                "enum": [
                  "OWNED",
                  "CONSENTED",
                  "LICENSED"
                ]
              },
              "rights_reference": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "redistribution_allowed": {
                "type": "boolean"
              }
            }
          },
          "instrument": {
            "type": "string",
            "minLength": 1
          },
          "qualities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "playing_styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "harmonic_examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annotations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "annotator_id",
                "annotation_date",
                "confidence",
                "notes",
                "segments"
              ],
              "properties": {
                "annotator_id": {
                  "type": "string",
                  "minLength": 1
                },
                "annotation_date": {
                  "type": "string",
                  "format": "date"
                },
                "confidence": {
                  "enum": [
                    "HIGH",
                    "MEDIUM",
                    "LOW"
                  ]
                },
                "notes": {
                  "type": "string"
                },
                "segments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "start",
                      "end",
                      "chord"
                    ],
                    "properties": {
                      "start": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "chord": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "performer_id": {
            "type": "string",
            "minLength": 1
          },
          "recording_session_id": {
            "type": "string",
            "minLength": 1
          },
          "device_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
