# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here

# RAG System Configuration (Optional)
RAG_DB_PATH=RAG/enhanced_chroma_store
RAG_COLLECTION_NAME=chord_analysis

# HorizonJam Configuration (Optional)
HORIZON_CONFIDENCE_THRESHOLD=0.3
