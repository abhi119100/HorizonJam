# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is in .gitignore.

# --- OpenAI ---
# Required for the RAG-enhanced GPT-4o tutor and (optionally) OpenAI TTS fallback.
OPENAI_API_KEY=sk-your-openai-key-here

# --- RAG (ChromaDB) ---
RAG_DB_PATH=RAG/unified_chroma_store
RAG_COLLECTION_NAME=music_theory
# Embedding backend: "openai" or a SentenceTransformer model name like "all-MiniLM-L6-v2"
RAG_MODEL_NAME=openai

# --- HorizonJam pipeline defaults ---
HORIZON_CONFIDENCE_THRESHOLD=0.3
HORIZON_MIN_DURATION=0.05

# --- TTS ---
# 1 = allow OpenAI TTS as a fallback when local Moshi is unavailable. 0 = local-only.
TTS_ALLOW_OPENAI_FALLBACK=1
# Path to local Kyutai Moshi model files. Must contain model.safetensors,
# tokenizer-e351c8d8-checkpoint125.safetensors, tokenizer_spm_32k_3.model.
# Leave unset to use OpenAI TTS only.
# MOSHI_MODEL_DIR=C:\models\kyutai

# --- Service URLs (used by tutor_ws_relay.py) ---
# Override the hardcoded TTS_SERVER_URL when running services on different hosts/ports.
TTS_SERVER_URL=http://localhost:5000/tts
